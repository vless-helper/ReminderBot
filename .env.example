# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token-here

# ID админов через запятую. Именно они подтверждают оплаты.
ADMIN_IDS=111111111, 222222222

# --- База данных ---
# В docker-compose это переопределяется на postgresql+asyncpg://...@db:5432/...
# Локально можно оставить sqlite+aiosqlite:///./bot.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/reminderbot

# Используется только для создания контейнера db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reminderbot

TZ=Europe/Moscow

# --- Деньги ---
BASE_PRICE=150
SUBSCRIPTION_DAYS=30
STANDARD_MONTH_DAYS=30

# Скидка за много конфигов: от BULK_THRESHOLD штук платим BULK_DISCOUNT процентов
BULK_THRESHOLD=10
BULK_DISCOUNT=95

# Скидки за срок оплаты (процент от цены, 85 = минус 15%)
PERIOD_DISCOUNT_3=95
PERIOD_DISCOUNT_6=90
PERIOD_DISCOUNT_12=85
MAX_EXTEND_MONTHS=12

# --- Напоминания ---
# Через сколько дней до заморозки слать напоминание
REMINDER_DAYS_BEFORE=3,1
# Часы отправки в REMINDER_TIMEZONE, включительно
REMINDER_START_HOUR=9
REMINDER_END_HOUR=21
REMINDER_CHECK_INTERVAL=600
REMINDER_TIMEZONE=Europe/Moscow

# --- Реквизиты оплаты ---
CARD_NUMBER=0000 0000 0000 0000
CARD_HOLDER=IVAN IVANOV

# --- Ссылки в инструкциях ---
AMNESIA_DOWNLOAD_LINK=https://amnezia.org/
TUNNEL_INSTRUCTION=

# --- Админка (cli-vless-manager) ---
# Внутри docker-compose: http://vless-manager:8080
ADMIN_API_URL=http://localhost:8080
ADMIN_API_KEY=
ADMIN_API_TIMEOUT=10
